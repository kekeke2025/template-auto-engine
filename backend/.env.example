# 服务配置
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=psd_template

# JWT配置
JWT_SECRET=psd-template-secret

# OSS配置（可选，用于存储文件）
OSS_ACCESS_KEY_ID=your_access_key
OSS_ACCESS_KEY_SECRET=your_access_secret
OSS_REGION=oss-cn-beijing
OSS_BUCKET=your-bucket-name

# MCP插件配置（可选，用于PSD解析和图片渲染）
MCP_PSD_PARSER_URL=http://localhost:8080/parse
MCP_IMAGE_RENDER_URL=http://localhost:8081/render
